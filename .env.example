# user-service environment configuration
# Copy to .env and adjust values as needed.

# REQUIRED: HMAC signing key for session cookies. Must be >= 32 bytes.
SESSION_SECRET=change-me-to-a-long-random-secret-key-32+bytes!

# Cookie Secure flag. Set to false for local HTTP development.
COOKIE_SECURE=false

# bcrypt cost factor (12 = ~250ms/hash).
BCRYPT_COST=12

# Login rate limiting.
RATE_LIMIT_MAX_FAILURES=5
RATE_LIMIT_LOCKOUT_MINUTES=15

# Session TTLs (seconds).
SESSION_TTL_SHORT=7200
SESSION_TTL_LONG=604800

# CORS: allowed frontend origin.
CORS_ORIGIN=http://localhost:5173

# Server listen address.
LISTEN_ADDR=0.0.0.0:3000
